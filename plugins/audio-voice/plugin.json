{
  "name": "audio-voice",
  "version": "1.0.0",
  "author": "VORTEX-OS",
  "license": "MIT",
  "description": "Text-to-speech narration. Wraps MiniMax-TTS.",
  "capability": "audio",
  "inputs": {
    "text":     { "type": "string",  "required": true,  "description": "The text to speak" },
    "voice":    { "type": "string",  "required": false, "default": "default", "enum": ["default", "male-1", "female-1", "child"] },
    "format":   { "type": "string",  "required": false, "default": "wav", "enum": ["wav", "mp3"] },
    "speed":    { "type": "number",  "required": false, "default": 1.0, "description": "Speech rate multiplier" }
  },
  "outputs": {
    "file":   { "type": "string", "description": "Absolute path to the generated audio file" },
    "format": { "type": "string", "description": "The file format" }
  },
  "command": {
    "type": "powershell",
    "entry": "invoke.ps1",
    "timeout_s": 120
  }
}
