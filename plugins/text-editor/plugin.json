{
  "name": "text-editor",
  "version": "1.0.0",
  "author": "VORTEX-OS",
  "license": "MIT",
  "description": "Polish / rephrase / summarize an existing text. Wraps MiniMax-Text-01.",
  "capability": "text",
  "inputs": {
    "text":    { "type": "string", "required": true,  "description": "The text to edit" },
    "action":  { "type": "string", "required": true,  "enum": ["polish", "rephrase", "shorten", "expand", "summarize", "fix-grammar"] },
    "target":  { "type": "string", "required": false, "description": "Optional target audience / register hint" }
  },
  "outputs": {
    "text":       { "type": "string", "description": "The edited text" },
    "action":     { "type": "string", "description": "The action performed" },
    "word_count": { "type": "integer", "description": "Word count of the output" }
  },
  "command": {
    "type": "powershell",
    "entry": "invoke.ps1",
    "timeout_s": 120
  }
}
