{
  "name": "code-python",
  "version": "1.0.0",
  "author": "VORTEX-OS",
  "license": "MIT",
  "description": "Python code generation. Wraps MiniMax-Text-01.",
  "capability": "code",
  "inputs": {
    "spec":     { "type": "string",  "required": true,  "description": "What the code should do" },
    "style":    { "type": "string",  "required": false, "default": "script", "enum": ["script", "module", "class", "notebook", "test"] },
    "filename": { "type": "string",  "required": false, "default": "output.py", "description": "Output filename" },
    "deps":     { "type": "string",  "required": false, "description": "Comma-separated list of pip packages to mention in the imports" }
  },
  "outputs": {
    "file":       { "type": "string", "description": "Absolute path to the generated .py file" },
    "filename":   { "type": "string", "description": "The output filename" },
    "line_count": { "type": "integer", "description": "Lines of code" }
  },
  "command": {
    "type": "powershell",
    "entry": "invoke.ps1",
    "timeout_s": 300
  }
}
